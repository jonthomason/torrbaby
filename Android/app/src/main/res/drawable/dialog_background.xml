<?xml version="1.0" encoding="utf-8"?>
<!-- The app's own dialog panel. Some televisions' system dialog is white, which hid the white list text. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="24dp">
    <shape android:shape="rectangle">
        <solid android:color="#1C1C1E" />
        <corners android:radius="24dp" />
        <stroke android:width="1dp" android:color="#3A3A3C" />
    </shape>
</inset>
