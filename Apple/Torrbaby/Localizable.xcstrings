    "Find uses this account for titles under China. Torrbaby saves a share's videos to the account, downloads them into your library, then deletes its copy from the account. The cookie is kept on your server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find uses this account for titles under China. Torrbaby saves a share's videos to the account, downloads them into your library, then deletes its copy from the account. The cookie is kept on your server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“查找”中的中国内容通过此账号获取。Torrbaby 会把分享中的视频存入该账号，下载到你的媒体库，然后从账号中删除这份副本。Cookie 仅保存在你的服务器上。"
          }
        }
      }
    },
