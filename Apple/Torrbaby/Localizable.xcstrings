          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于你已加入的私有站点。其结果会显示在“查找”的中国来源中。密钥保存在你的服务器上，仅用于搜索该站点和获取你添加的种子。"
          }
        }
      }
